# ── SMTP for the contact form (/api/contact) ──────────────
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# Gmail: create an App Password (Google Account → Security → 2-Step
# Verification → App passwords) and use it as SMTP_PASS. Normal account
# passwords will NOT work.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=mochochokoboiketlo@gmail.com
SMTP_PASS=your-16-char-app-password

# Optional. Defaults to: Ristar-art Contact <SMTP_USER>
# SMTP_FROM=Ristar-art Contact <mochochokoboiketlo@gmail.com>

# ── Auth.js / Google sign-in (/login) ─────────────────────
# 1. Generate a secret:  openssl rand -hex 32
# 2. Google Cloud Console → APIs & Services → Credentials →
#    Create OAuth client ID (type: Web application).
#    Authorized redirect URI (dev):  http://localhost:5173/auth/callback/google
#    Authorized redirect URI (prod): https://YOUR_DOMAIN/auth/callback/google
AUTH_SECRET=your-32-byte-random-hex
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
