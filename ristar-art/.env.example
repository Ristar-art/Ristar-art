# ── Frontend (static build) ───────────────────────────────
# The site is a fully static build with no server of its own. The only thing
# it needs is the public URL of the API that receives contact form
# submissions (see ../ristar-art-backend).
#
# Env files, in the order Vite applies them:
#
#   .env.production   committed. Used by `npm run build`. Points at the live
#                     API — nothing to do, it is already correct.
#   .env              gitignored, yours. Used by `npm run dev`. Copy this
#                     file to `.env` to point dev at your local backend.
#
# PUBLIC_ vars are inlined into the client bundle at build time, so changing
# one means rebuilding and redeploying. They are visible in page source —
# never put a secret behind a PUBLIC_ prefix.

# Local development, with the backend running via `npm run dev` in
# ../ristar-art-backend:
PUBLIC_API_BASE=http://localhost:8080
