# ── Server ────────────────────────────────────────────────
# Copy to `.env` for local development. In production set these
# as real environment variables on the host instead.
NODE_ENV=development
PORT=8080

# Browser origins allowed to call this API, comma separated.
# Required in production. In development it defaults to the
# SvelteKit dev and preview servers.
#
# These are the origins of the SITE that calls this API — not this API's own
# origin. api.whiterobesdevelopment.co.za does not belong in this list.
# Include every hostname the site is actually served from; if the apex and
# www both resolve, both need to be here or one of them breaks.
CORS_ORIGINS=https://whiterobesdevelopment.co.za,https://www.whiterobesdevelopment.co.za

# Set when running behind a reverse proxy (Render, Railway, Fly, nginx)
# so rate limiting sees the real client IP and not the proxy's.
# Use the number of proxies in front of you, or `loopback`.
TRUST_PROXY=1

# ── Contact form email (Resend) ───────────────────────────
# Sends over HTTPS (port 443), so it works even where outbound SMTP
# is blocked. Get the key from https://resend.com -> API Keys.
RESEND_API=re_your_resend_api_key

# Where enquiries are delivered.
CONTACT_TO=mochochokoboiketlo@gmail.com

# Sender. Must be on a domain verified in Resend. Until the domain is
# verified, onboarding@resend.dev works but only delivers to your own
# Resend account email.
# RESEND_FROM=White Robes Development <contact@whiterobesdevelopment.co.za>
