{
	"name": "ristar-art-backend",
	"version": "1.0.0",
	"description": "API for whiterobesdevelopment.co.za — contact form delivery.",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20.12"
	},
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=.env src/index.ts",
		"build": "tsc -p tsconfig.json",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"cors": "^2.8.6",
		"express": "^5.3.0",
		"express-rate-limit": "^8.7.1",
		"helmet": "^8.3.0"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.5",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
